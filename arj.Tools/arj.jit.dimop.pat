max v2;#N vpatcher 121 63 689 671;#N comlet Operator;#P inlet 458 64 15 0;#N comlet Summed matrix out;#P outlet 29 532 15 0;#P window setfont "Sans Serif" 9.;#P comment 220 522 219 196617 output column sum/product/min/max/etc. to calculate rowwise operation \, one could use jit.transform to preform a row/column swap prior to sending matrix through this patch.;#P hidden message 475 368 50 196617 symbol +;#P hidden newex 475 341 45 196617 loadbang;#P newex 84 418 55 196617 prepend op;#P comment 161 401 208 196617 set the operator;#P user ubumenu 84 397 60 196617 0 1 1 0;#X add pass;#X add *;#X add /;#X add +;#X add -;#X add +m;#X add -m;#X add %;#X add min;#X add max;#X add abs;#X add avg;#X add absdiff;#X add !pass;#X add !/;#X add !-;#X add !%;#X add &;#X add |;#X add ^;#X add ~;#X add >>;#X add <<;#X add &&;#X add ||;#X add !;#X add >;#X add <;#X add >=;#X add <=;#X add ==;#X add !=;#X add >p;#X add <p;#X add >=p;#X add <=p;#X add ==p;#X add !=p;#X add sin;#X add cos;#X add tan;#X add asin;#X add acos;#X add atan;#X add atan2;#X add sinh;#X add cosh;#X add tanh;#X add asinh;#X add acosh;#X add atanh;#X add exp;#X add exp2;#X add ln;#X add log2;#X add log10;#X add hypot;#X add pow;#X add sqrt;#X add ceil;#X add floor;#X add round;#X add trunc;#X add ignore;#X prefix_set 0 0 <none> 0;#X pattrmode 1;#P comment 244 347 208 196617 jit.scanwrap in spew mode to output a sequence of row vectors;#N vpatcher 20 74 420 374;#P outlet 91 142 15 0;#P inlet 91 67 15 0;#P connect 0 0 1 0;#P pop;#P newobj 121 449 35 196617 p noop;#P newex 29 493 95 196617 jit.matrix @thru 0;#P comment 162 440 208 196617 for the first vector \, set the right input \, then for each subsequent vector operate on the left + right vectors. the result of each operation placed into the right input;#P newex 29 449 63 196617 jit.op @op +;#P newex 29 405 35 196617 gate 2;#P newex 29 361 27 196617 t 1 l;#P newex 11 108 6